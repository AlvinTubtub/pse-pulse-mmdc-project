# ==============================================================================
# PSE Pulse Frontend — Environment Configuration Template
# ==============================================================================

# Development when Next.js runs separately on :3000 against FastAPI on :8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Allows development-only synthetic fallback records.
# MUST be false for production builds.
NEXT_PUBLIC_DEMO_MODE=true

# Azure Production Build Settings (Nginx provides same-origin API proxying):
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_DEMO_MODE=false
