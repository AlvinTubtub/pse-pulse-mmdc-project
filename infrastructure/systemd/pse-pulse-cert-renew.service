[Unit]
Description=Renew PSE Pulse's short-lived IP TLS certificate with ACME TLS-ALPN-01
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pse-pulse/acme.env
OnFailure=pse-pulse-failure-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/pse-pulse-renew-ip-certificate
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/etc/pse-pulse/tls /var/lib/lego /run
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pse-pulse-cert-renew
