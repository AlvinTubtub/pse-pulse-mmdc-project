[Unit]
Description=PSE Pulse strict production end-of-day session
After=network-online.target pse-pulse-api.service
Wants=network-online.target
ConditionPathIsDirectory=/opt/pse-pulse/current
OnFailure=pse-pulse-failure-alert@%n.service

[Service]
Type=oneshot
User=psepulse-eod
Group=psepulse-eod
SupplementaryGroups=psepulse
WorkingDirectory=/opt/pse-pulse/current
EnvironmentFile=/etc/pse-pulse/eod.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PROCESS_ROLE=production-eod
ExecStart=/opt/pse-pulse/current/backend/.venv-inference/bin/python -m backend.pipeline.production_runner --scheduled --reconcile-pending
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/pse-pulse /etc/pse-pulse /var/lib/pse-pulse
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pse-pulse-eod
