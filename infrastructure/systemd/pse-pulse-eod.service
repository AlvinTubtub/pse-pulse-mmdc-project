[Unit]
Description=PSE Pulse End-of-Day Pipeline Execution Service
After=network.target pse-pulse-api.service

[Service]
Type=oneshot
User=psepulse
Group=psepulse
WorkingDirectory=/opt/pse-pulse
EnvironmentFile=/etc/pse-pulse/.env
ExecStart=/opt/pse-pulse/backend/.venv/bin/python -m backend.pipeline.runner

# Memory ceiling during batch run
MemoryMax=400M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
