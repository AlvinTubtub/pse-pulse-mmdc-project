# API database role: read-only SELECT/CONNECT grants only.
# Install at /etc/pse-pulse/api.env as root:root mode 0600.
# Replace host and credentials only through the separately reviewed secret route.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+psycopg://psepulse_api:REPLACE_WITH_API_ROLE_SECRET@REPLACE_WITH_OWNER_VERIFIED_PRIVATE_POSTGRES_FQDN:5432/REPLACE_WITH_DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
EXPECTED_PRIVATE_DATABASE_HOST=REPLACE_WITH_OWNER_VERIFIED_PRIVATE_POSTGRES_FQDN
DATABASE_TLS_ROOT_CERT=/etc/ssl/certs/ca-certificates.crt
CORS_ORIGINS=
DEMO_MODE=false
AUTO_CREATE_SCHEMA=false
REAL_MODELS_ENABLED=false
MODEL_ARTIFACT_ACTIVATION_ENABLED=false
PROCESS_ROLE=api
MODEL_ARTIFACTS_DIR=/var/lib/pse-pulse/models
