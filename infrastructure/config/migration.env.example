# Dedicated schema-owner credentials; never reuse or expose them to API/EOD.
# Install only for a maintenance window as root:root mode 0600, then remove.
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
AUTO_CREATE_SCHEMA=false
REAL_MODELS_ENABLED=false
MODEL_ARTIFACT_ACTIVATION_ENABLED=false
PROCESS_ROLE=migration
DATABASE_URL=postgresql+psycopg://psepulse_migrator:REPLACE_WITH_MIGRATION_ROLE_SECRET@REPLACE_WITH_OWNER_VERIFIED_PRIVATE_POSTGRES_FQDN:5432/REPLACE_WITH_DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
EXPECTED_PRIVATE_DATABASE_HOST=REPLACE_WITH_OWNER_VERIFIED_PRIVATE_POSTGRES_FQDN
DATABASE_TLS_ROOT_CERT=/etc/ssl/certs/ca-certificates.crt
