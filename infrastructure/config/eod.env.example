# EOD database role: approved market-data, forecast, and audit writes only.
# Install at /etc/pse-pulse/eod.env as root:root mode 0600.
# Both SHA pins must be owner-reviewed and match protected staged files.
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
AUTO_CREATE_SCHEMA=false
PROCESS_ROLE=production-eod
REAL_MODELS_ENABLED=false
MODEL_ARTIFACT_ACTIVATION_ENABLED=false
DATABASE_URL=postgresql+psycopg://psepulse_eod:REPLACE_WITH_EOD_ROLE_SECRET@REPLACE_WITH_OWNER_VERIFIED_PRIVATE_POSTGRES_FQDN:5432/REPLACE_WITH_DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
EXPECTED_PRIVATE_DATABASE_HOST=REPLACE_WITH_OWNER_VERIFIED_PRIVATE_POSTGRES_FQDN
DATABASE_TLS_ROOT_CERT=/etc/ssl/certs/ca-certificates.crt
MODEL_ARTIFACT_BUNDLE_VERSION=REPLACE_AFTER_APPROVED_ARTIFACT_REVIEW
PSE_CALENDAR_MANIFEST=/var/lib/pse-pulse/calendar/approved-calendar.json
PSE_CALENDAR_MANIFEST_SHA256=REPLACE_AFTER_OFFICIAL_CALENDAR_REVIEW
PSE_SOURCE_APPROVAL_INDEX=/var/lib/pse-pulse/approvals/source-approval-index.json
PSE_SOURCE_APPROVAL_INDEX_SHA256=REPLACE_AFTER_OWNER_REVIEWS_STAGED_SOURCES
PSE_INCOMING_DIR=/var/lib/pse-pulse/incoming
MODEL_ARTIFACTS_DIR=/var/lib/pse-pulse/models
