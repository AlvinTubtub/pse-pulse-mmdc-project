# Copy to /etc/pse-pulse/acme.env with owner/group root and mode 0600 only.
# Use Let's Encrypt staging for the initial external validation. This template
# cannot contact the production ACME endpoint until a separate owner approval.
ACME_EMAIL=owner@example.invalid
ACME_IP=REPLACE_WITH_OWNER_VERIFIED_VM_PUBLIC_IP
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ALLOW_PRODUCTION=false
LEGO_BIN=/usr/local/bin/lego
LEGO_VERSION=REPLACE_AFTER_REVIEWED_BUILD
LEGO_SHA256=REPLACE_AFTER_REVIEWED_BUILD
LEGO_PATH=/var/lib/lego
