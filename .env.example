# Local development only. Production configuration is documented in
# infrastructure/config/api.env.example and must be installed outside Git.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./pse_pulse_dev.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE=true
AUTO_CREATE_SCHEMA=false
REAL_MODELS_ENABLED=false
MODEL_ARTIFACT_ACTIVATION_ENABLED=false
MODEL_ARTIFACTS_DIR=/var/lib/pse-pulse/models
